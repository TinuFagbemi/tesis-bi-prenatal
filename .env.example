# Configuración de ejemplo exclusiva para desarrollo local.
# Copia este archivo como .env y reemplaza la contraseña antes de utilizarlo.
# Nunca guardes el archivo .env real en Git.
#
# Cada desarrolladora copia este archivo como .env en su propia computadora y
# define sus propias credenciales locales. El archivo .env no se versiona.
# Inicialmente cada computadora tiene su propia base de datos local e independiente;
# una base compartida se configuraría después en un servidor apropiado, nunca
# exponiendo directamente una computadora personal a Internet.

APP_NAME=FetalAlert API
APP_ENV=development

# Credenciales ficticias e inseguras: solo muestran el formato esperado.
# "dev_only_change_me" NO es una contraseña válida para ningún uso real.
POSTGRES_USER=fetalalert_dev
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_DB=fetalalert_dev

# Puerto de la computadora para el PostgreSQL de Docker.
# Se usa 5433 porque el puerto 5432 ya lo ocupa el PostgreSQL instalado en Windows.
# Herramientas de escritorio (Power BI, pgAdmin) se conectan al PostgreSQL de Docker
# mediante localhost:5433. El puerto interno del contenedor sigue siendo 5432.
POSTGRES_PORT=5433

# Conexión interna utilizada por la API ejecutada dentro de Docker.
# Debe utilizar db:5432, no localhost:5433.
# Si excepcionalmente se ejecuta la API directamente desde Windows (fuera de Docker),
# hay que proporcionarle a ese proceso DATABASE_URL con localhost:5433, porque db
# solo existe dentro de la red interna de Docker.
DATABASE_URL=postgresql+psycopg://fetalalert_api:dev_only_change_me@db:5432/fetalalert_dev

# ============================================================
# Separación de credenciales por proceso (SCRUM-98)
# ============================================================

# Tres procesos, tres roles, tres variables. La separación es el punto del
# ticket: si la API corriera con el rol que posee las tablas, ninguna política
# RLS la afectaría y el aislamiento sería decorativo.
#
#   DATABASE_URL          -> fetalalert_api      : runtime de la API, restringido.
#   ALEMBIC_DATABASE_URL  -> rol migrador/owner  : DDL, y tambien el cargador
#                                                  del dataset simulado, que es
#                                                  mantenimiento y no runtime.
#   ETL_DATABASE_URL      -> fetalalert_etl      : rol técnico del ETL.
#   (Power BI)            -> fetalalert_powerbi  : credencial externa, no va aquí.
#
# NO HAY RESPALDO ENTRE ELLAS. Si falta ALEMBIC_DATABASE_URL, las migraciones se
# detienen; si falta ETL_DATABASE_URL, el ETL se detiene. Ninguna cae sobre
# DATABASE_URL, porque un respaldo silencioso es exactamente el fallo que esta
# separación existe para evitar.
#
# Docker Compose pasa DATABASE_URL al servicio api y NO le pasa las otras dos:
# el proceso web no debe siquiera recibir la credencial del migrador.
#
# Los roles NOLOGIN (fetalalert_rls_owner, fetalalert_provision_owner,
# fetalalert_mantenimiento) no tienen contraseña ni URL: los crea
# "python scripts/bootstrap_roles.py aplicar" y nadie se conecta como ellos.
#
# Credenciales ficticias e inseguras: solo muestran el formato esperado.
ALEMBIC_DATABASE_URL=postgresql+psycopg://fetalalert_dev:dev_only_change_me@db:5432/fetalalert_dev
ETL_DATABASE_URL=postgresql+psycopg://fetalalert_etl:dev_only_change_me@db:5432/fetalalert_dev

# ============================================================
# Autenticación (SCRUM-70)
# ============================================================

# Material de firma de los tokens de sesión. NO HAY VALOR POR OMISIÓN: la API se
# niega a arrancar sin él, a propósito. Debe aportar al menos 32 bytes de
# material aleatorio y no puede repetir POSTGRES_PASSWORD.
#
# Docker Compose pasa esta variable, de forma explícita, al servicio api y a
# ningún otro. Si se deja vacía, la API falla cerrado al arrancar. Las
# operaciones que solo usan la base -- docker compose up -d db, alembic, el
# cargador del dataset y el ETL -- no la necesitan.
#
# Genera el tuyo, y no lo copies de ningún ejemplo ni lo compartas:
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Se deja vacío aquí a propósito: un valor de ejemplo que funcionara acabaría
# reutilizado. El archivo .env real no se versiona.
JWT_SECRET_KEY=

# Vigencia del token en minutos. Opcional: entre 1 y 1440, y 30 si no se define.
# Compose también pasa 30 al servicio api cuando falta.
# JWT_EXPIRATION_MINUTES=30

# Token de sesión que el nodo edge simulado presenta a la API al sincronizar.
# Corresponde a una cuenta PACIENTE simulada y se obtiene con
# POST /api/v1/autenticacion/token. Se deja vacío: cárgalo en la variable de
# entorno de la sesión, sin escribirlo en un archivo ni en el historial del
# shell (el README explica el procedimiento).
#
# Los comandos del nodo que no usan la red -- init, capturar, estado y traza --
# funcionan sin esta variable. Es del nodo edge: Compose no la pasa al servicio
# api.
EDGE_API_TOKEN=
